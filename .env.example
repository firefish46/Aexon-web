# Copy to .env.production on the server and fill in.

# Where quote requests are emailed
QUOTE_TO=cmo@dmebd.com

# SMTP account used to send them (from your email host)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=website@example.com
SMTP_PASS=change-me
# Address the email is sent from. Must be allowed by the SMTP account.
SMTP_FROM=website@example.com

# Optional: also forward each request as JSON (Slack, Zapier, CRM)
# QUOTE_WEBHOOK_URL=
