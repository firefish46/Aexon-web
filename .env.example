# Copy to .env.production in the project folder on the server and fill in.
# Never commit the real file.

# Where quote requests are emailed
QUOTE_TO=cmo@dmebd.com

# The cPanel mailbox the site sends from (create it in cPanel > Email Accounts).
# The app runs on the same server as the mail, so it connects to 127.0.0.1 and
# checks the certificate against mail.aexon.uk.
SMTP_HOST=127.0.0.1
SMTP_PORT=465
SMTP_TLS_SERVERNAME=mail.aexon.uk
SMTP_USER=website@aexon.uk
SMTP_PASS=the-mailbox-password
# Address the email is sent from. Must be the mailbox above.
SMTP_FROM=website@aexon.uk

# Optional: also forward each request as JSON (Slack, Zapier, CRM)
# QUOTE_WEBHOOK_URL=
